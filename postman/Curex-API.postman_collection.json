              "raw": "{{baseUrl}}/api/admin/users/registered?startDate=2024-01-01T00:00:00&endDate=2025-12-31T23:59:59",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "registered"],
