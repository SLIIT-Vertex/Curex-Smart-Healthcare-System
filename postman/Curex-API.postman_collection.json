    {
      "name": "Files (Generic Storage)",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Upload File (Report/Image/Doc)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "ownerId",  "value": "{{userId}}", "type": "text" },
                { "key": "category", "value": "REPORT",     "type": "text" },
                { "key": "file",     "type": "file",        "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "upload"]
            }
          }
        },
        {
          "name": "Get File Metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/files/FILE_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "FILE_ID_HERE"]
            }
          }
