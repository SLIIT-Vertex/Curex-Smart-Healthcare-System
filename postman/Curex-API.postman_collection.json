            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{userId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{userId}}", "status"]
            }
          }
        },
        {
          "name": "Reject Doctor",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Admin-Id",   "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"REJECT\",\n  \"notes\": \"Incomplete documentation submitted.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{userId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{userId}}", "status"]
            }
          }
        },
        {
          "name": "Suspend User",
          "request": {
