# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED. Minimum 64 characters for HS512.
# Generate: openssl rand -base64 64
JWT_SECRET=change-me-to-a-real-64-char-minimum-secret-generated-by-openssl-rand
JWT_EXPIRATION=900000          # 15 minutes (access token)
JWT_REFRESH_EXPIRATION=604800000  # 7 days (refresh token)

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=curex_user
DB_PASSWORD=curex_password

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password   # https://myaccount.google.com/apppasswords

# ── Text.lk SMS Gateway ────────────────────────────────────────────────────────
# Get your API token from https://app.text.lk → Settings → API
TEXT_LK_API_TOKEN=your-textlk-api-token
# Approved sender ID from your Text.lk account (shown on recipient's phone)
TEXT_LK_SENDER_ID=CUREX
# Base URL — only change this if Text.lk updates their API version
TEXT_LK_API_BASE_URL=https://app.text.lk/api/v3

# ── Notification ──────────────────────────────────────────────────────────────
NOTIFICATION_EMAIL_FROM=noreply@curex.com

# ── Groq AI (ai-symptom-service) ─────────────────────────────────────────────
# Sign up: https://console.groq.com → API Keys. Used by POST /api/ai/symptoms/check.
# Leave empty to use rule-based fallback when that flow is implemented.
GROQ_API_KEY=
